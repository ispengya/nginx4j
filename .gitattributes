# Normalize line endings in the repository while leaving the worktree alone.
* text=auto

# Source, config and docs are stored with LF so the repo is identical on every platform.
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries are never touched.
*.jar binary
*.png binary
*.jpg binary
*.gif binary